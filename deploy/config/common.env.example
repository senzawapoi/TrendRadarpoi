# systemd EnvironmentFile example. Keep real credentials outside Git.
CONFIG_PATH=/etc/trendradar/config.yaml
INTELLIGENCE_DB_PATH=/var/lib/trendradar/output/intelligence.db
AI_FRONTIER_DB_PATH=/var/lib/trendradar/output/ai_frontier.db
TRENDRADAR_HEALTH_DIR=/run/trendradar/health
TRENDRADAR_LOCK_DIR=/run/trendradar
TRENDRADAR_CONTROL_DIR=/var/lib/trendradar/control
TRENDRADAR_RELEASE_ID=replace-with-release-id
INTELLIGENCE_REQUIRE_EXISTING=true
INTELLIGENCE_SQLITE_SYNCHRONOUS=FULL
INTELLIGENCE_HEALTH_REQUIRE_SOURCE_RUNS=false
INTELLIGENCE_HEALTH_REQUIRE_BACKUP=true
INTELLIGENCE_HEALTH_HEARTBEAT_MAX_AGE_SECONDS=60
INTELLIGENCE_HEALTH_SOURCE_MAX_AGE_HOURS=6
INTELLIGENCE_HEALTH_QUEUE_WAIT_SECONDS=300
INTELLIGENCE_HEALTH_BACKUP_MAX_AGE_HOURS=26
TRENDRADAR_BACKUP_DIR=/var/backups/trendradar/local
TRENDRADAR_OFFSITE_ENABLED=false
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_MODEL_COOLDOWN_SECONDS=60
LARK_DELIVERY_MODE=instant
TRENDRADAR_HEALTH_EXPECTED_ROLES=bot,worker
TRENDRADAR_HEALTH_EXPECTED_SOURCES=
LARK_ENABLED=false
INTELLIGENCE_RESEARCH_ENABLED=false
