# Non-secret production template. Copy to /etc/trendradar/config.yaml and
# review every path and target before enabling a role.
app:
  timezone: Asia/Shanghai

intelligence:
  enabled: true
  database_path: /var/lib/trendradar/output/intelligence.db
  require_existing: true
  sqlite_synchronous: FULL
  health:
    require_backup: true
    heartbeat_max_age_seconds: 60
    source_max_age_hours: 6
    queue_wait_seconds: 300
    backup_max_age_hours: 26
    backup_dir: /var/backups/trendradar/local
    expected_roles: [bot, worker]
    expected_sources: []
  assistant:
    enabled: true
  research:
    enabled: false
    capabilities: []

lark:
  enabled: false
  allowed_chat_types: [p2p, group]
  identity_fields: {}
  delivery:
    enabled: false
    time: "08:00"
    end: "08:30"

ai_frontier:
  enabled: true
  database_path: /var/lib/trendradar/output/ai_frontier.db
