# Source credentials belong here or in the VPS secret manager, never in YAML.
FREQUENCY_WORDS_PATH=/opt/trendradar/current/config/frequency_words.txt
GEMINI_ENABLED=false
INTELLIGENCE_SECURITY_ENABLED=true

# 有界等待默认关闭；仅接受 0..1800 的有限秒数。
# 1800 仅为候选，D5 时序/新鲜度门槛未通过前不得在生产启用。
# 等待不提供 FIFO、持久排队或补回 systemd 合并触发的保证。
TRENDRADAR_COLLECTOR_WAIT_SECONDS=0

# 主采集角色范围（all | general | hotboard | rss | security）。
# 配合独立 trendradar-collect-security.timer（每 4 小时运行 --scope security），
# 主采集默认设为 general（单轮内合流 hotboard+rss 为单次 general Story 聚类）。
TRENDRADAR_MAIN_SCOPE=general
