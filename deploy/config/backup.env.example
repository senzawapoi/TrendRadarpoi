# Backup destination credentials are managed separately from business secrets.
TRENDRADAR_RELEASE_ID=replace-with-release-id
TRENDRADAR_OFFSITE_ENABLED=false
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
TRENDRADAR_OFFSITE_TIMEOUT_SECONDS=900
TRENDRADAR_OFFSITE_KILL_GRACE_SECONDS=10
TRENDRADAR_BACKUP_KEEP_HOURS=12
TRENDRADAR_BACKUP_KEEP_DAYS=3
TRENDRADAR_BACKUP_KEEP_WEEKS=0
TRENDRADAR_BACKUP_MAX_MIB=2048
TRENDRADAR_BACKUP_MIN_FREE_PERCENT=20
