+def quoted_event(*, parent="parent-news", root="root-news", **kwargs):
+    value = payload(
+        chat="group", mention=True, content={"text": "@_user_1 Explain this news"}, **kwargs
+    )
+    value["event"]["message"].update(parent_id=parent, root_id=root)
+    return value
