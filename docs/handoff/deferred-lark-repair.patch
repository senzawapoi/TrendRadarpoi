+        key = "stories" if outcome.name == "search_stories" else "items"
+        rows = payload.get(key)
+        interval = payload.get("time_range")
+        truncation = payload.get("truncation")
+        return (
+            isinstance(rows, list)
+            and not rows
+            and isinstance(interval, Mapping)
