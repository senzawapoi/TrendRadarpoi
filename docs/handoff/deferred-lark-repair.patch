+def test_one_correction_with_matching_evidence_recovers_and_preserves_failed_audit(
+    seeded_intelligence,
+    caplog,
+):
+    ref = f"story:{seeded_intelligence.story.id}"
+    reply, gemini, service = run_turn(
+        seeded_intelligence,
